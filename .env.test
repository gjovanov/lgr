# Environment
NODE_ENV=test

# Server
HOST=0.0.0.0
PORT=3099

# Database (overridden by mongodb-memory-server in tests)
MONGODB_URI=mongodb://localhost:27018/lgr_test

# Auth
JWT_SECRET=lgr-test-secret

# File Storage
UPLOAD_DIR=./uploads-test
MAX_FILE_SIZE=50000000

# AI Recognition
ANTHROPIC_API_KEY=test-key

# Company Lookup
VERIFYVAT_TOKEN=test-token

# Cloud Integrations
GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
DROPBOX_APP_KEY=test
DROPBOX_APP_SECRET=test
ONEDRIVE_CLIENT_ID=test
ONEDRIVE_CLIENT_SECRET=test

# FR-11 (#21): the digest scheduler must never fire during tests.
DIGEST_CHECK_INTERVAL_MS=0

# S-08: suites fail logins on purpose; the throttle would lock them out. Its own test enables it.
LOGIN_THROTTLE_ENABLED=false

# FR-13.10 (#24): the backup scheduler must never fire during tests.
BACKUP_CHECK_INTERVAL_MS=0

# FR-13.43 (#24): the retention sweep must never fire during tests. It is the only scheduled
# job that DELETES, and a suite that seeds rows with backdated `createdAt` would otherwise
# race it. `retention.flow.test.ts` calls `retentionTick()` directly with an explicit `now`.
RETENTION_CHECK_INTERVAL_MS=0

# FR-13.48-13.59 (#24): no test may reach Google Drive, and none may seal a bundle.
#
# Empty is already the default, so these lines are not what makes the tests inert — they are
# what stops a developer's own exported BACKUP_* variables from leaking into a test run and
# uploading a real bundle from a laptop. `unit/backup-drive.test.ts` stubs `fetch` and sets
# its own config; it does not read these.
#
# WARNING: this file IS COMMITTED TO GIT (.gitignore covers .env and .env.local, not this).
# Every value here is a placeholder and must stay one. A real refresh token on this line is a
# credential published to GitHub that can delete the off-site backups.
BACKUP_GOOGLE_DRIVE_REFRESH_TOKEN=
BACKUP_ENCRYPTION_PUBLIC_KEY=

# FR-13.26 — pinned empty so the §5.7 routes fail closed in tests exactly as they do on an
# unconfigured server. `integration/backup-restore.flow.test.ts` sets `config.backup.sysAdmins`
# per test to exercise both halves of the gate; it does not read this.
BACKUP_SYS_ADMINS=

# FR-14.19 (#57): the ephemeral-desktop reaper must never fire during tests. It DELETES rows, and
# `desktop-enrollment.flow.test.ts` calls `reapEphemeralDesktops()` directly with an explicit
# `now` so it can assert both the positive and the negative case.
DESKTOP_REAPER_INTERVAL_MS=0
NODE_REAPER_INTERVAL_MS=0

# FR-10 — pinned EMPTY so no test can send real email, whatever the developer's `.env` holds.
#
# ⚠ This is not belt-and-braces. `.env` on a working machine carries a live SendGrid key, and
# `bun test` without `--env-file=.env.test` picks it up: `daily-digest.flow` then reported
# `sent` instead of `skipped` and `digest-routes.flow` got 200 instead of 503 — which means a
# request actually left the machine for SendGrid during a test run. Those two tests exist to
# assert the UNCONFIGURED behaviour, so an inherited key does not just fail them, it inverts
# what they are testing.
#
# ⚠ `FROM_EMAIL` is pinned too: `sendEmail` reports `not_configured` when either is missing, and
# leaving one set makes which-one-is-missing a thing that varies by machine.
SENDGRID_API_KEY=
FROM_EMAIL=
