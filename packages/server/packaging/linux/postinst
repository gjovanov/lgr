#!/bin/sh
# LGR Server (FR-20.10, plan step P1-7): what the .deb and the .rpm do once their files are in place.
#
# ⚠ It never starts, stops, restarts or enables the service (roomler's rule for roomlerd): an upgrade
# must not bounce a shop's till in the middle of a sale. The first start is the operator's:
#   sudo systemctl enable --now lgr-server
# An upgrade's version runs from the service's next start; the update helper, which that start pulls
# in, watches it run and goes back to the previous version by itself if it does not (FR-20.20).
set -e

USER=lgr
DATA=/var/lib/lgr

if ! getent passwd "$USER" >/dev/null 2>&1; then
  if command -v useradd >/dev/null 2>&1; then
    useradd --system --user-group --home-dir "$DATA" --no-create-home --shell /usr/sbin/nologin "$USER"
  else
    adduser --system --group --home "$DATA" --no-create-home --shell /usr/sbin/nologin "$USER"
  fi
fi

# The data outlives the package: the database, the keys and the licences. Only the two directories
# themselves are set here; what the service writes inside them is its own.
mkdir -p "$DATA/keys"
chown "$USER:$USER" "$DATA" "$DATA/keys"
chmod 0750 "$DATA"
chmod 0700 "$DATA/keys"

# The version this package carries, beside the others, and `current` pointed at it: never an older
# one than runs, never one that failed before.
/opt/lgr-server/installer/lgr-server update install-bundle

# #901: the PDF browser's sandbox needs a user namespace, which Ubuntu 24.04's AppArmor allows only a
# program a profile names. The profile names the browser of every version and confines nothing else
# (apparmor/lgr-server-chrome). It goes in only where AppArmor 4 is: `userns` is a 4.0 rule, and an
# older AppArmor, which restricts nothing, would fail to read the file at every boot. A container
# (no AppArmor of its own) gets the file and loads nothing. Never fatal: without the profile a master
# still sells, and says at start that it prints no PDF.
PROFILE=lgr-server-chrome
if [ -f /etc/apparmor.d/abi/4.0 ] && [ -f "/opt/lgr-server/installer/apparmor/$PROFILE" ]; then
  if install -m 0644 "/opt/lgr-server/installer/apparmor/$PROFILE" "/etc/apparmor.d/$PROFILE" \
    && command -v apparmor_parser >/dev/null 2>&1 && aa-enabled --quiet 2>/dev/null; then
    apparmor_parser -r -T -W "/etc/apparmor.d/$PROFILE" \
      || echo "lgr-server: the AppArmor profile $PROFILE did not load, so the PDF browser has no sandbox here and prints no PDF; PDF_CHROME_NO_SANDBOX=1 in /var/lib/lgr/config/api.env prints without one" >&2
  fi
fi

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi
exit 0
