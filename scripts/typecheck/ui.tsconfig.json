{
  // FR-32.3: the web app (the one SPA, its modules in `web/src/modules/`) and the two shared UI libraries as
  // ONE program for `vue-tsc`, the way `scripts/typecheck.ts` checks them. Each package's own
  // tsconfig.json has the same options (`tsconfig.dom.json`). `desktop-ui` is a program of its
  // own: it has its own `@/` alias. `unit/typecheck-config.test.ts` holds this list to the packages.
  "extends": "../../tsconfig.dom.json",
  "include": [
    "../../packages/ui-shared/src/**/*.ts",
    "../../packages/ui-shared/src/**/*.vue",
    "../../packages/ui-shell/src/**/*.ts",
    "../../packages/ui-shell/src/**/*.vue",
    "../../packages/web/src/**/*.ts",
    "../../packages/web/src/**/*.vue"
  ]
}
