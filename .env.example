# Server
HOST=0.0.0.0
PORT=4001

# Database
MONGODB_URI=mongodb://localhost:27018/lgr

# Auth
JWT_SECRET=lgr-dev-secret-change-in-production

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# AI Recognition
ANTHROPIC_API_KEY=

# Cloud Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/org/{orgId}/integration/google-drive/callback
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Currency
EXCHANGE_RATE_API_KEY=

# OAuth Social Login
OAUTH_BASE_URL=http://localhost:4001
OAUTH_FRONTEND_URL=http://localhost:4001
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE=
STRIPE_ENTERPRISE_PRICE=

# Email (SendGrid) — used by invite/activation mails and by "Email invoice" (FR-10).
# Without a key the app never sends: the invoice endpoint answers 503 "not configured"
# rather than reporting a fake success.
SENDGRID_API_KEY=
# MUST be an address verified as a sender in SendGrid, or every send is rejected.
FROM_EMAIL=

# FR-11 (#21) — daily digest scheduler tick. 0 disables it entirely (tests set 0).
DIGEST_CHECK_INTERVAL_MS=

# FR-13.6 (#24) — where the Layer-1 backup jobs on mars publish their verification result.
# Defaults to <UPLOAD_DIR>/.backup-status; override only if the jobs write somewhere else.
# The digest's Backups section is opt-in per org (settings.dailyDigest.sections.backups).
BACKUP_STATUS_DIR=
# A report older than this is treated as a FAILURE, not as missing data.
BACKUP_STATUS_MAX_AGE_HOURS=

# FR-13.10 (#24) — per-org backup scheduler tick. 0 disables it entirely (tests set 0).
BACKUP_CHECK_INTERVAL_MS=
# Org-local hour the per-org bundle runs at (FR-13.7 places it after the Layer-1 jobs).
BACKUP_HOUR=
# Bundles kept per org per kind. GENERATIONS, never an age: a run of failed nights must not
# be able to age out the last good bundle. The scheduler is opt-in per org —
# `scripts/configure-backup.ts --org <slug> --execute`.
BACKUP_KEEP_PER_ORG=
