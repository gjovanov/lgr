# Server
HOST=0.0.0.0
PORT=4001

# Database
MONGODB_URI=mongodb://localhost:27018/lgr

# Auth
JWT_SECRET=lgr-dev-secret-change-in-production

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# AI Recognition
ANTHROPIC_API_KEY=

# Cloud Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/org/{orgId}/integration/google-drive/callback
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Currency
EXCHANGE_RATE_API_KEY=

# OAuth Social Login
OAUTH_BASE_URL=http://localhost:4001
OAUTH_FRONTEND_URL=http://localhost:4001
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE=
STRIPE_ENTERPRISE_PRICE=

# Email (SendGrid) — used by invite/activation mails and by "Email invoice" (FR-10).
# Without a key the app never sends: the invoice endpoint answers 503 "not configured"
# rather than reporting a fake success.
SENDGRID_API_KEY=
# MUST be an address verified as a sender in SendGrid, or every send is rejected.
FROM_EMAIL=

# FR-11 (#21) — daily digest scheduler tick. 0 disables it entirely (tests set 0).
DIGEST_CHECK_INTERVAL_MS=

# FR-13.6 (#24) — where the Layer-1 backup jobs on mars publish their verification result.
# Defaults to <UPLOAD_DIR>/.backup-status; override only if the jobs write somewhere else.
# The digest's Backups section is opt-in per org (settings.dailyDigest.sections.backups).
BACKUP_STATUS_DIR=
# A report older than this is treated as a FAILURE, not as missing data.
BACKUP_STATUS_MAX_AGE_HOURS=

# FR-13.10 (#24) — per-org backup scheduler tick. 0 disables it entirely (tests set 0).
BACKUP_CHECK_INTERVAL_MS=
# Org-local hour the per-org bundle runs at (FR-13.7 places it after the Layer-1 jobs).
BACKUP_HOUR=
# Bundles kept per org per kind. GENERATIONS, never an age: a run of failed nights must not
# be able to age out the last good bundle. The scheduler is opt-in per org —
# `scripts/configure-backup.ts --org <slug> --execute`.
BACKUP_KEEP_PER_ORG=
# ⚠ Whether the daily mail may carry the BUNDLE ITSELF. Default false.
# What it attaches is the SEALED artifact and never a plaintext one: a bundle holds every
# tenant-scoped collection, including `User` documents whose `password` is not `select: false`
# — bcrypt hashes and every contact's tax number — and SendGrid is outside the cluster and
# keeps what it is given (FR-13.23). With `true` but no BACKUP_ENCRYPTION_PUBLIC_KEY, nothing
# is attached and the mail says why. The MANIFEST goes either way, which proves what should
# exist without shipping any of it.
BACKUP_EMAIL_ATTACH_BUNDLE=
# How many times one org-day may be attempted before the scheduler gives up on it. A failed
# run deliberately leaves the day claimable so one transient failure does not silently cost
# the org its night; this is the bound that stops a deterministic failure retrying forever.
BACKUP_MAX_ATTEMPTS_PER_DAY=

# --- Off-site copy: sealing + Google Drive (FR-13.23, FR-13.48–13.59) ---
#
# ⚠ Without these, a per-org bundle is written to <UPLOAD_DIR>/<orgId>/backups/ and stays
# there — a node-local hostPath on k8s-worker-2, the same node the live database is pinned to.
# One disk holding both the data and its backup is the state FR-13 exists to end.
#
# The PUBLIC half of the sealing key. Asymmetric on purpose: the cluster can seal a bundle and
# cannot open one, so reaching the cluster does not mean reading every backup ever taken. The
# private half goes in the password manager and NEVER on a cluster node — an encrypted backup
# whose key is lost with the cluster is not a backup.
#   bun scripts/backup-crypto.ts keygen        (run it OFF the cluster)
# Unset disables the Drive upload entirely rather than shipping plaintext.
BACKUP_ENCRYPTION_PUBLIC_KEY=
#
# Google Drive. Obtain with `bun --env-file=.env scripts/google-drive-consent.ts`, or through
# POST /api/org/:orgId/integration/google-drive/callback, which returns it once.
#
# ⚠ It lives HERE and not on the Org document, deliberately: `orgs` is inside every backup
# bundle, so a Drive credential stored there would ship — inside the thing it protects — the
# credential that can DELETE the off-site copy (FR-13.56).
# ⚠ There is no API-key alternative. A Google API key authenticates anonymous access to PUBLIC
# data and cannot write to a private Drive; a service account has no storage quota and cannot
# own files, so it fails `403 storageQuotaExceeded` against its own empty Drive (FR-13.48).
# ⚠ Use a DEDICATED Google account. This credential can delete the off-site copy and must be
# revocable without taking anything else with it.
BACKUP_GOOGLE_DRIVE_REFRESH_TOKEN=
# Defaults to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — one OAuth app, not two. Set this pair
# when Drive has its own OAuth client (e.g. the Desktop-app client in .secrets/):
# `bun scripts/google-drive-consent.ts --append-env .env` writes it here with the token, and
# the app must refresh with the SAME client the consent was granted to, or Google answers
# invalid_client on the first nightly run.
# BACKUP_GOOGLE_DRIVE_CLIENT_ID=
# BACKUP_GOOGLE_DRIVE_CLIENT_SECRET=
# The ONE root folder this app owns in the connected Drive: everything goes to
# <folder>/<org slug>/<kind>/ and nothing is created beside it. Must be a single folder name —
# empty, "/" or a value containing "/" is refused rather than resolving to My Drive root.
# BACKUP_GOOGLE_DRIVE_FOLDER=LGR
# Generations kept on Drive per org and per kind. Counted, never aged: a run of failed nights
# must not be able to delete the last good copy.
# BACKUP_GOOGLE_DRIVE_KEEP=14
# Headroom the pre-flight demands on top of the artifact. A free Google account is 15 GB shared
# with Gmail and Photos; the job refuses up front rather than failing mid-transfer.
# BACKUP_GOOGLE_DRIVE_MIN_FREE_BYTES=536870912

# ── FR-13.58 (#24) — object storage: the off-site copy a leaked token cannot delete ──────────
#
# Drive has NO object-lock: the same credential that writes can delete, so a stolen refresh
# token, a buggy rotation or a human tidying the Drive removes the off-site copy. The artifact
# that has to survive all three is the ten-year archive (ЗСч чл. 12; payroll fifty). An S3
# bucket with VERSIONING + OBJECT LOCK refuses that delete — to the writing key and to the
# account root alike. Any S3-compatible endpoint: Backblaze B2, Cloudflare R2, Hetzner, MinIO.
#
# ⚠ Nothing is uploaded unless BACKUP_ENCRYPTION_PUBLIC_KEY is set. Same rule as Drive: a
# bundle carries every collection in the org and does not leave the cluster in the clear.
# ⚠ Turn Object Lock on WHEN CREATING THE BUCKET — it cannot be enabled afterwards on most
# providers, and COMPLIANCE retention cannot be shortened by anyone once an object carries it.
#
# BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# BACKUP_S3_REGION=eu-central-003
# BACKUP_S3_BUCKET=lgr-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket, so one bucket can hold more than LGR.
# BACKUP_S3_PREFIX=lgr
# What goes here: archive (the yearly cold tier only — the default), all (also every nightly
# bundle), or off. ⚠ `all` means a 14-generation rotation lands in a bucket whose objects are
# RETAINED and cannot be deleted until their lock expires — that is a bill, not a policy.
# BACKUP_S3_SCOPE=archive
# Generations kept per prefix. 0 (the default) means keep everything, which is what a ten-year
# retention obligation wants. Ignored entirely for archives and under an object lock.
# BACKUP_S3_KEEP=0
# COMPLIANCE or GOVERNANCE. Empty sends no retention header at all, which a bucket WITHOUT
# Object Lock requires — sending one there is a 400, not a no-op.
# BACKUP_S3_OBJECT_LOCK_MODE=COMPLIANCE
# BACKUP_S3_OBJECT_LOCK_YEARS=10
# Path-style (https://endpoint/bucket/key) by default — B2, R2 and MinIO all serve it. Set
# false for AWS proper, where virtual-host style is expected.
# BACKUP_S3_FORCE_PATH_STYLE=true

# ── FR-13.26 (#24) — the system-administrator allow-list for the restore screen ──────────────
#
# Comma-separated user ids or email addresses, matched case-insensitively against both.
#
# ⚠ EMPTY BY DEFAULT, AND THAT IS THE DESIGN. Unset means every route under §5.7 — create,
# upload, inspect, restore — answers 403 to EVERYONE, including an organisation's own `admin`.
# The highest role in the product is org-scoped, so gating a restore on it would hand the shop
# owner a button that deletes issued fiscal documents and rolls invoice numbering backwards
# into numbers already in customers' hands.
#
# ⚠ This is a config list rather than a permission ON PURPOSE. A permission would need a model
# change, a PermissionSet backfill and a re-login before it took effect, because a JWT carries
# the permissions it was issued with. This is correct from the first request after deploy.
#
# BACKUP_SYS_ADMINS=ops@example.com,68b1f0c4e8a1b2c3d4e5f601
BACKUP_SYS_ADMINS=

# Ceiling for an UPLOADED bundle on the restore screen. Deliberately NOT UPLOAD_MAX_FILE_SIZE
# (50 MB): a `full` bundle exceeds that today and a `data` bundle will around year 8, so
# sharing the documents cap would make upload fail on exactly the artifacts it exists to carry.
# Default 1 GiB.
# BACKUP_RESTORE_MAX_UPLOAD_BYTES=1073741824
